# API Configuration
KIMI_API_KEY=your-kimi-api-key-here
# Alibaba Cloud Model Studio / Bailian (Qwen)
# LLM_PROVIDER=dashscope  # qwen and bailian are accepted aliases
# DASHSCOPE_API_KEY=your-dashscope-api-key-here
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 通用回退：未设置 KIMI_API_KEY 时，若配置了 OPENROUTER_API_KEY，则自动改走
# OpenRouter（kimi-* 会映射为 moonshotai/kimi-k2）。
# OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: LLM Provider Settings
LLM_PROVIDER=kimi
LLM_MODEL=kimi-k3

# System Hint Features (all default to true)
ENABLE_TIMESTAMPS=true
ENABLE_TOOL_COUNTER=true
ENABLE_TODO_LIST=true
ENABLE_DETAILED_ERRORS=true
ENABLE_SYSTEM_STATE=true

# Formatting Options
TIMESTAMP_FORMAT=%Y-%m-%d %H:%M:%S
SIMULATE_TIME_DELAY=false

# Execution Options
MAX_ITERATIONS=20
VERBOSE=false
COMMAND_TIMEOUT=30
