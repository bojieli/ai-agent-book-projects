    {
      "name": "mcp_spawn_subagent",
      "description": "Spawn a sub-agent to handle a delegated task. Supports sync (waits and returns result) and async (returns a task_id immediately) modes, and two context-passing strategies: 'minimal' or 'llm_generated'.",
      "inputSchema": {
        "properties": {
          "task": {
            "description": "The sub-task to delegate to the sub-agent",
            "title": "Task",
            "type": "string"
          },
          "context_strategy": {
            "default": "minimal",
            "description": "Context-passing strategy: 'minimal' (task + hand-picked slice only) or 'llm_generated' (extra LLM call synthesizes privacy-filtered context)",
            "title": "Context Strategy",
            "type": "string"
          },
          "mode": {
            "default": "sync",
            "description": "'sync' waits and returns the result; 'async' starts in background and returns a task_id",
            "title": "Mode",
            "type": "string"
          },
          "parent_context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Parent agent trajectory/state to prepare per the chosen strategy",
            "title": "Parent Context"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional explicit role for the sub-agent's system prompt",
            "title": "Role"
          },
          "minimal_slice": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "For 'minimal' strategy: hand-picked slice (string, dict, or list of keys into parent_context)",
            "title": "Minimal Slice"
          },
          "business_rules": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "For 'llm_generated' strategy: privacy/compression rules",
            "title": "Business Rules"
          }
        },
        "required": [
          "task"
        ],
        "title": "mcp_spawn_subagentArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "mcp_spawn_subagentOutput",
        "type": "object"
      }
    },
