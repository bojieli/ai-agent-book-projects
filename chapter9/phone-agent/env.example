# Optional hosted model providers for ReAct planning and dialogue. The keys
# stay in the local Python process and are never returned to the browser.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides. The saved acceptance pins the built-in local planner and
# parser; set PHONE_MODEL_PROVIDER to openai or openrouter to opt in.
PHONE_MODEL_PROVIDER=auto
PHONE_PLANNER_MODEL=gpt-4o-mini
PHONE_DIALOGUE_MODEL=gpt-4o-mini
