# Official pine-voice SDK credentials.
PINE_ACCESS_TOKEN=your_pine_access_token
PINE_USER_ID=your_pine_user_id

# Mandatory fail-closed allowlist for any real call. The Agent may only call
# this exact consenting destination. Keep the acknowledgement literal.
PINE_AUTHORIZED_TEST_NUMBER=your_authorized_e164_number
PINE_TEST_CALL_CONSENT=I_HAVE_EXPLICIT_CONSENT

# ReAct planning and post-call structured fact extraction.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Optional: ReAct text model through OpenRouter. Live business-number search
# still requires OPENAI_API_KEY because it uses OpenAI's web_search tool.
# OPENROUTER_API_KEY=your_openrouter_key
# PHONE_SEARCH_MODEL=gpt-4.1-mini
