# 仅用于本地脱敏重建。复制为 deploy/local/.env 后再调整。
# 不要把商业模型 API Key 或真实企业凭据提交到仓库。

# PostgreSQL（一个实例、两个隔离数据库）
PLATFORM_POSTGRES_USER=platform
PLATFORM_POSTGRES_PASSWORD=platform-dev-only
PLATFORM_POSTGRES_DB=platform
PLATFORM_POSTGRES_PORT=55432
JIYAOJUN_DATABASE_URL=postgresql+psycopg://platform:platform-dev-only@127.0.0.1:55432/jiyaojun
SAFETY_DATABASE_URL=postgresql+psycopg://platform:platform-dev-only@127.0.0.1:55432/safety

# Redis
PLATFORM_REDIS_PORT=56379
JIYAOJUN_REDIS_URL=redis://127.0.0.1:56379/1
SAFETY_REDIS_URL=redis://127.0.0.1:56379/0

# SeaweedFS（S3-compatible）
PLATFORM_SEAWEED_MASTER_PORT=59333
PLATFORM_SEAWEED_FILER_PORT=58888
PLATFORM_S3_PORT=58333
PLATFORM_SEAWEED_ADMIN_PORT=53646
PLATFORM_S3_BUCKET=jiyaojun
JIYAOJUN_S3_ENDPOINT=http://127.0.0.1:58333
JIYAOJUN_S3_BUCKET=jiyaojun
JIYAOJUN_S3_ACCESS_KEY=local-dev-access
JIYAOJUN_S3_SECRET_KEY=local-dev-secret

# Qdrant
PLATFORM_QDRANT_HTTP_PORT=56333
PLATFORM_QDRANT_GRPC_PORT=56334
JIYAOJUN_QDRANT_URL=http://127.0.0.1:56333
JIYAOJUN_QDRANT_COLLECTION=meeting_knowledge
JIYAOJUN_VECTOR_BACKEND=memory
JIYAOJUN_OBJECT_BACKEND=mock

# 纪要君只能通过安全控制面调用模型或申请高风险工具授权。
# 空 URL = OfflineSafetyGateway（确定性离线，run_all 全绿）
JIYAOJUN_SAFETY_GATEWAY_URL=
JIYAOJUN_SAFETY_GATEWAY_TOKEN=
JIYAOJUN_MODEL_MAX_INPUT_TOKENS=8192
JIYAOJUN_MODEL_MAX_OUTPUT_TOKENS=2048
JIYAOJUN_MODEL_DAILY_CALL_LIMIT=100
JIYAOJUN_MODEL_MONTHLY_BUDGET_CNY=200

# M5 可选观测（需 compose --profile observability）
JIYAOJUN_OTEL_ENDPOINT=
# 例：http://127.0.0.1:54318

# M5 可选身份 / 密钥（需 compose --profile identity / secrets）
PLATFORM_KEYCLOAK_PORT=58080
PLATFORM_OPENBAO_PORT=58200
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only
OPENBAO_ROOT_TOKEN=local-dev-root-token
JIYAOJUN_OIDC_ISSUER_URL=
JIYAOJUN_OPENBAO_ADDR=
PLATFORM_OTEL_HTTP_PORT=54318
PLATFORM_OTEL_GRPC_PORT=54317
PLATFORM_PROMETHEUS_PORT=59090
PLATFORM_GRAFANA_PORT=53000
PLATFORM_TEMPO_HTTP_PORT=53200
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-dev-only

# 安全平台审计链：双副本时建议开启 PG advisory lock
SAFETY_AUDIT_ADVISORY_LOCK=0

# OpenAI-compatible 商业模型。空值表示离线确定性模式。
# 仅由安全控制面上游读取；纪要君不得直连。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=5
MODEL_MAX_INPUT_TOKENS=8192
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_DAILY_CALL_LIMIT=100
MODEL_MONTHLY_BUDGET_CNY=200

# 安全边界
SAFETY_MODEL_UPSTREAM_URL=
SAFETY_MODEL_UPSTREAM_KEY=
SAFETY_SCANNER_MODE=shim
SAFETY_REMOTE_FAIL_CLOSED=1
SAFETY_OIDC_DISABLED=1
SAFETY_SESSION_STORE=redis
SAFETY_MASTER_KEY=local-dev-change-me-32bytes-key
