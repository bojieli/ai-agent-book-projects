{
  "name": "ai-agent-book-astro-preview",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test scripts/*.test.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
