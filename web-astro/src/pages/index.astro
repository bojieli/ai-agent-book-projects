---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import AgentArchitecture from '../components/AgentArchitecture.astro';
import Icon from '../components/Icon.astro';
import { chapters, chapterPath, repo } from '../lib/book';
---

<Layout title="AI Agents in Depth — From principles to practice">
  <Header />
  <main id="main-content">
    <section class="home-hero page-width" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="status-dot"></span> An open-source book
        </p>
        <h1 id="hero-title">
          AI Agents<br /><span class="serif-title">in Depth.</span>
        </h1>
        <p class="hero-subtitle">
          Design principles.<br />Engineering practice.
        </p>
        <p class="hero-description">
          Understand how agents work.<br />Learn to build systems that do.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={chapterPath}
            >Start reading <Icon name="arrow" /></a
          ><a class="text-link" href="#contents"
            >Explore the book <span aria-hidden="true">↓</span></a
          >
        </div>
        <p class="hero-credit">
          By <a href="https://github.com/bojieli">Bojie Li</a> &amp; the open-source
          community
        </p>
      </div>
      <AgentArchitecture />
    </section>
    <div class="book-facts page-width">
      <span><strong>10</strong> chapters, from foundations to systems</span
      ><span><strong>15</strong> language editions</span><span
        ><span class="fact-symbol" aria-hidden="true">↗</span> Open source. Open to
        everyone.</span
      >
    </div>
    <section
      id="contents"
      class="contents-section page-width"
      aria-labelledby="contents-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">A path from understanding to building</p><h2
            id="contents-title"
          >
            Inside the book<span class="accent-period">.</span>
          </h2>
        </div><p>
          Start with the fundamentals.<br />Follow your curiosity from there.
        </p>
      </div>
      <div class="chapter-grid">
        {
          chapters.map((chapter) => (
            <a
              class:list={[
                'chapter-card',
                { 'first-chapter': chapter.number === 1 },
              ]}
              href={chapter.href}
              aria-label={`${chapter.label}. ${chapter.title}${chapter.external ? ' — existing reading site' : ''}`}
            >
              <>
                <span class="chapter-number">{chapter.label}</span>
                <div>
                  <h3>{chapter.title}</h3>
                  <p>{chapter.description}</p>
                  {chapter.number === 1 && (
                    <span class="start-label">START HERE</span>
                  )}
                </div>
                <Icon
                  name={chapter.external ? 'external' : 'arrow'}
                  size={22}
                />
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="practice-strip page-width">
      <div>
        <p class="eyebrow">Ideas become clearer when you run them</p><h2>
          Read it. Then build it.
        </h2><p>
          Explore the companion experiments, inspect the code, and make it your
          own.
        </p>
      </div><a class="button button-outline" href={`${repo}/tree/main/chapter1`}
        >Chapter 1 experiments <Icon name="external" /></a
      >
    </section>
  </main>
  <footer class="site-footer page-width">
    <a class="footer-title" href="/">AI Agents in Depth</a><span
      >Written in the open. Built to be explored.</span
    ><a href={`${repo}/blob/main/LICENSE`}
      >Apache 2.0 <Icon name="external" size={14} /></a
    >
  </footer>
</Layout>
