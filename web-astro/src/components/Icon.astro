---
interface Props {
  name:
    | 'arrow'
    | 'external'
    | 'moon'
    | 'sun'
    | 'menu'
    | 'close'
    | 'focus'
    | 'book'
    | 'download'
    | 'chevron';
  size?: number;
}
const { name, size = 20 } = Astro.props;
const paths = {
  arrow: 'M4 12h16M13 5l7 7-7 7',
  external: 'M7 17 17 7M7 7h10v10',
  moon: 'M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z',
  sun: 'M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z',
  menu: 'M4 6h16M4 12h16M4 18h16',
  close: 'm6 6 12 12M6 18 18 6',
  focus: 'M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5',
  book: 'M12 5v15M12 5C9 3 5 3 3 4v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-2-1-6-1-9 1Z',
  download: 'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5',
  chevron: 'm8 4 8 8-8 8',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={paths[name]}></path></svg
>
